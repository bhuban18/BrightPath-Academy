# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE DATABASE & AUTHENTICATION CONFIGURATION
# Find these in your Supabase Dashboard -> Project Settings -> API
# ==============================================================================
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase Public "anon" API Key (safe to use in frontend with Row Level Security)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ==============================================================================
# EMAIL NOTIFICATIONS (SERVER-SIDE / NETLIFY FUNCTIONS)
# Find your API key at https://resend.com (Free tier: 100 emails/day, 3,000/month)
# ==============================================================================
# Resend API Key (starts with re_...)
RESEND_API_KEY="re_123456789abcdef"

# Email address where the website owner receives new student alerts
ADMIN_NOTIFICATION_EMAIL="admissions@brightpathacademy.edu.in"

# Verified sender email address (Use onboarding@resend.dev for testing without custom domain)
SENDER_EMAIL="BrightPath Academy <onboarding@resend.dev>"
